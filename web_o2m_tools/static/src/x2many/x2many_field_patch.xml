<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.X2ManyField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_x2m_control_panel')]/*[1]" position="before">
            <t t-if="this.o2mShowSearchBar"
               t-component="this.o2mSearchBarComponent"
               record="this.props.record"
               name="this.props.name"
               config="this.o2mToolsConfig"/>
        </xpath>
        <xpath expr="//div[hasclass('o_cp_pager')]" position="attributes">
            <attribute name="t-if">this.o2mShowPager</attribute>
        </xpath>
    </t>

</templates>
