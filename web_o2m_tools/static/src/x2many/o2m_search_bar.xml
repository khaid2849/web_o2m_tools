<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_o2m_tools.O2mSearchBar">
        <div class="o_web_o2m_search d-flex flex-wrap align-items-center gap-2 me-auto d-print-none"
             t-att-class="{'o_web_o2m_locked': locked}"
             t-att-data-tooltip="locked ? lockedTooltip : false">
            <div t-if="props.config.search" class="o_web_o2m_search_input input-group input-group-sm">
                <span class="input-group-text"><i class="oi oi-search" role="img" aria-hidden="true"/></span>
                <input type="search"
                       class="form-control"
                       t-att-placeholder="placeholder"
                       t-att-aria-label="placeholder"
                       t-att-disabled="locked"
                       t-att-value="ui.searchInput"
                       t-on-input="onSearchInput"
                       t-on-keydown="onSearchKeydown"/>
            </div>
            <Dropdown t-if="props.config.filter" beforeOpen.bind="loadFacets" disabled="locked"
                      menuClass="'o_web_o2m_filter_menu'">
                <button class="o_web_o2m_filter_toggle btn btn-sm btn-secondary" t-att-disabled="locked">
                    <i class="fa fa-filter me-1" role="img" aria-hidden="true"/>Filters
                    <span t-if="selectedCount" class="badge rounded-pill text-bg-primary ms-1" t-esc="selectedCount"/>
                </button>
                <t t-set-slot="content">
                    <div t-if="ui.facetsError" class="dropdown-item-text text-danger">Could not load the filters.</div>
                    <div t-elif="ui.facets and !ui.facets.length" class="dropdown-item-text text-muted">No filter configured.</div>
                    <t t-foreach="ui.facets or []" t-as="group" t-key="group.id">
                        <div t-if="!group_first" role="separator" class="dropdown-divider"/>
                        <h6 class="dropdown-header" t-esc="group.name"/>
                        <div t-if="!group.options.length" class="dropdown-item-text text-muted small">No value</div>
                        <t t-foreach="group.options" t-as="option" t-key="option_index">
                            <DropdownItem closingMode="'none'" onSelected="() => this.toggleOption(group.id, option.key)">
                                <CheckBox value="isSelected(group.id, option.key)"
                                          onChange="() => this.toggleOption(group.id, option.key)">
                                    <span class="d-flex align-items-center w-100">
                                        <span class="text-truncate flex-grow-1" t-esc="option.label"/>
                                        <span class="ms-3 text-muted" t-esc="option.count"/>
                                    </span>
                                </CheckBox>
                            </DropdownItem>
                        </t>
                    </t>
                </t>
            </Dropdown>
            <span t-if="list.o2mIsFiltered" class="o_web_o2m_count text-muted small" t-esc="countLabel"/>
            <button t-if="isActive" type="button" class="o_web_o2m_clear btn btn-sm btn-link px-1" t-on-click="clear">
                <i class="fa fa-times me-1" role="img" aria-hidden="true"/>Clear filters
            </button>
        </div>
    </t>

</templates>
