<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_o2m_tools.O2mPresetMenu">
        <div role="separator" class="dropdown-divider"/>
        <h6 class="dropdown-header">Column presets</h6>
        <t t-foreach="presets" t-as="preset" t-key="preset.id">
            <DropdownItem class="'o_web_o2m_preset'" closingMode="'none'" onSelected="() => this.apply(preset)">
                <div class="d-flex align-items-center gap-1 w-100">
                    <i class="fa fa-fw" t-att-class="isCurrent(preset) ? 'fa-check text-primary' : ''" role="img" aria-hidden="true"/>
                    <span class="o_web_o2m_preset_name text-truncate flex-grow-1" t-esc="preset.name"/>
                    <span t-if="preset.is_default" class="badge text-bg-light">Default</span>
                    <span class="o_web_o2m_preset_actions d-flex">
                        <button type="button" class="btn btn-link btn-sm p-0 px-1 o_web_o2m_preset_favorite"
                                t-att-title="preset.is_favorite ? titles.removeFavorite : titles.addFavorite"
                                t-on-click.stop="() => this.toggleFavorite(preset)">
                            <i class="fa" t-att-class="preset.is_favorite ? 'fa-star text-warning' : 'fa-star-o'"/>
                        </button>
                        <button type="button" class="btn btn-link btn-sm p-0 px-1 o_web_o2m_preset_update"
                                t-att-title="titles.update"
                                t-on-click.stop="() => this.update(preset)">
                            <i class="fa fa-floppy-o"/>
                        </button>
                        <button type="button" class="btn btn-link btn-sm p-0 px-1 o_web_o2m_preset_default"
                                t-att-title="preset.is_default ? titles.unsetDefault : titles.setDefault"
                                t-on-click.stop="() => this.toggleDefault(preset)">
                            <i class="fa" t-att-class="preset.is_default ? 'fa-thumb-tack text-primary' : 'fa-thumb-tack text-muted'"/>
                        </button>
                        <button type="button" class="btn btn-link btn-sm p-0 px-1 o_web_o2m_preset_rename"
                                t-att-title="titles.rename" t-on-click.stop="() => this.rename(preset)">
                            <i class="fa fa-pencil"/>
                        </button>
                        <button type="button" class="btn btn-link btn-sm p-0 px-1 text-danger o_web_o2m_preset_delete"
                                t-att-title="titles.delete" t-on-click.stop="() => this.remove(preset)">
                            <i class="fa fa-trash"/>
                        </button>
                    </span>
                </div>
            </DropdownItem>
        </t>
        <DropdownItem class="'o_web_o2m_preset_save'" onSelected="() => this.saveNew()">
            <i class="fa fa-fw fa-plus me-1" role="img" aria-hidden="true"/>Save current columns…
        </DropdownItem>
    </t>

</templates>
