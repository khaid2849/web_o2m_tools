<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ListRenderer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_optional_columns')]//t[@t-set-slot='content']" position="inside">
            <t t-if="this.o2mPresetTable and this.displayOptionalFields"
               t-component="this.o2mPresetMenuComponent"
               t-props="this.o2mPresetMenuProps"/>
        </xpath>
    </t>

</templates>
